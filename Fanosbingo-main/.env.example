# ============================================================================
#  የኛ bingo — frontend environment (Vite)
#  Copy to `.env` and fill in. NEVER commit `.env` (it is git-ignored).
#  These are the ONLY variables the frontend code reads (src/**).
# ============================================================================

# [YOU PROVIDE]  Base URL of the NestJS backend's REST API (see backend/.env.example).
# Public. Safe in the browser — it's just a hostname.
VITE_API_BASE_URL=http://localhost:3000/api

# [DEV ONLY — leave blank / delete for production]
# Lets you open the Mini App in a normal browser with a fake Telegram user.
# Requires ALLOW_UNVERIFIED_TELEGRAM=true on the backend. Example:
# VITE_DEV_TELEGRAM_USER={"id":111,"first_name":"Dev","username":"dev"}
VITE_DEV_TELEGRAM_USER=

# ----------------------------------------------------------------------------
#  Backend-only variables — see backend/.env.example, NOT this file:
#  DATABASE_URL, JWT_ACCESS_SECRET, ADMIN_KEY, TELEGRAM_BOT_TOKEN,
#  TELEGRAM_BOT_USERNAME, YENA_BINGO_APP_URL, ALLOW_UNVERIFIED_TELEGRAM.
# ----------------------------------------------------------------------------
#  Business + Telebirr config live in the backend's `settings` DATABASE table
#  (seeded by prisma/seed.ts; edit via the admin panel). NOT env vars:
#
#     TELEBIRR_ACCOUNT_NAME     = YOUR_ACCOUNT_NAME      <- YOU PROVIDE
#     TELEBIRR_ACCOUNT_NUMBER   = YOUR_ACCOUNT_NUMBER    <- YOU PROVIDE
#     TELEBIRR_INSTRUCTIONS     = <payment steps>        <- YOU PROVIDE
#     GAME_URL                  = ''                     <- YOU set (deployed Mini App URL)
#     ETB5_ROOM_PRICE=5   ETB5_ROOM_CAPACITY=400
#     ETB10_ROOM_PRICE=10 ETB10_ROOM_CAPACITY=200
#     MAX_STANDARD_CARTELAS=600   MAX_CARTELAS_PER_PLAYER=4
#     WINNER_PERCENTAGE=80        HOUSE_PERCENTAGE=20
#     DEPOSIT_MIN_ETB=30  WITHDRAWAL_MIN_ETB=200
#     SIGNUP_BONUS_ETB=10
#
#  See docs/YENA_BINGO_OWNER_SETUP_REQUIREMENTS.md for the full checklist.
