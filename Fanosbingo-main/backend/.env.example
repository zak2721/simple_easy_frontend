# ============================================================================
#  የኛ bingo — backend environment (NestJS)
#  Copy to `.env` and fill in. NEVER commit `.env`.
# ============================================================================

# The app connects as the restricted "app_runtime" role (Row-Level Security
# tenant isolation — see backend/prisma/migrations/20260926090000_row_level_security).
DATABASE_URL=postgresql://app_runtime:CHANGE_ME@localhost:5432/yena_bingo

# [YOU GENERATE] openssl rand -base64 32 — sets/rotates app_runtime's password
# on every startup (see docker-entrypoint.sh / prisma/ensure-app-runtime-password.ts).
# Must match the password used in DATABASE_URL above.
APP_RUNTIME_PASSWORD=

# Superuser connection, used ONLY by `prisma migrate deploy`/`generate` and the
# app_runtime password-rotation step — never by the running app (see
# backend/prisma/schema.prisma's `directUrl`). Never point the running app at
# this: Postgres does not allow RLS to restrict a superuser at all, so doing
# so would silently bypass every tenant-isolation policy.
MIGRATE_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/yena_bingo

PORT=3000
CORS_ALLOWED_ORIGINS=http://localhost:5173

# [YOU GENERATE] openssl rand -hex 32 — sign/verify player + admin access tokens
JWT_ACCESS_SECRET=

# [CLAUDE/YOU GENERATE] openssl rand -hex 32 — break-glass owner bootstrap (see POST /api/auth/admin/bootstrap)
ADMIN_KEY=

# [TELEGRAM PROVIDES]
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# [YOU GENERATE] openssl rand -hex 32 — Telegram echoes this back on every
# webhook delivery as X-Telegram-Bot-Api-Secret-Token; without it the webhook
# is unauthenticated and spoofable. Re-run POST /admin/telegram/setup-webhook
# after changing this so Telegram picks up the new value.
TELEGRAM_WEBHOOK_SECRET=

# [YOU GENERATE] openssl rand -base64 32 — encrypts each operator's own
# Telegram bot token at rest. Required as soon as any operator other than the
# default one has a bot configured. Back it up separately from DB dumps:
# losing it makes every stored operator bot token unreadable.
PLATFORM_ENCRYPTION_KEY=

# [YOU PROVIDE] public HTTPS URL of the deployed Mini App. Other operators'
# Mini Apps are served under <this URL>/o/<operator-slug>.
YENA_BINGO_APP_URL=

# [DEV ONLY] skips Telegram initData signature verification — NEVER set in production
ALLOW_UNVERIFIED_TELEGRAM=false

RECEIPTS_STORAGE_PATH=./storage/receipts

# [OPTIONAL] public theme logos/banners — must be a PERSISTENT volume in
# production (see docker-compose.prod.yml), or uploads are lost on redeploy.
PUBLIC_STORAGE_PATH=./storage/public

# [OPTIONAL] Sentry error tracking — leave blank for a safe no-op (see main.ts).
# DevOps audit finding (Medium): undocumented here meant a deployment
# following this file alone would run with zero error tracking, silently.
SENTRY_DSN=

# development | production — gates pretty vs. raw JSON logging (see
# common/logger/logger.module.ts). Dockerfile sets this to `production`
# automatically; only needed here for a non-Docker local run.
NODE_ENV=development

POSTGRES_DB=yena_bingo
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# DevOps audit finding (Medium): provisioned as a full service in both
# compose files with a health check, but NOTHING in backend/src actually
# uses a Redis client today — dead infrastructure as of this audit. Either
# wire it in (session store / cache / distributed rate-limit backing —
# needed if this backend is ever horizontally scaled, see PERFORMANCE
# section of the production readiness report) or remove it to reduce
# attack surface and operational overhead.
REDIS_URL=redis://localhost:6379
